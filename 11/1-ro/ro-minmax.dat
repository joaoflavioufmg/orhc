# Health Care Facility Location Under Uncertainty
# Robust Optimization
# Ref: Correia, I., & Saldanha-da-Gama, F. (2019). 
# Facility location under uncertainty. Location science, 185-213.
# Minmax Data (Small Instance)
#############################################################################
# glpsol -m ro.mod -d ro.dat --cuts

# ################################################
# # P-median
# ################################################
# set I:= 1   2   3   4; # The set of all origin.
# set J:= 1   2   3; # The set of all (possible) destination points.


# # Demand at oring i in I
# param D:=
# 1   5
# 2   10
# 3   15
# 4   20
# ; 

# # Distance or travel time from i in J, to j in J
# param A: 1  2   3 :=
#     1   1   5   10
#     2   2   6   11
#     3   3   7   12
#     4   4   8   13
#     ;

# # New facilities to be located
# param P:= 2; 
###############################################



################################################
# The Minmax P-median
# ###############################################
set I:= 1   2   3   4;  # The set of all origin.
set J:= 1   2   3;      # The set of all (possible) destination points.
set W:= 1   2;          # Finite set of scenarios w in Omega


# Demand at oring i in I and scenario w in W
param D: 1  2:=
    1   5   6
    2   10  11
    3   15  12
    4   20  13
; 

# Distance or travel time from i in J, to j in J, in scen w
param A 
    [*,*,1]: 1  2   3:=
    1   1   5   10
    2   2   6   11
    3   3   7   12
    4   4   8   13

    [*,*,2]: 1  2   3:=
    1   2   6   11
    2   3   7   12
    3   2   6   11
    4   3   7   12
    ;

# New facilities to be located
param P:= 2; 

param Vopt:=
1   150.00   
2   108.00
;

end;
###############################################
