# Health Care Facility Location Under Uncertainty
# Robust Optimization
# Ref: Correia, I., & Saldanha-da-Gama, F. (2019). 
# Facility location under uncertainty. Location science, 185-213.
# Stochastic Programming Facility Location Problem
#############################################################################
# > glpsol -m .\sp-cflp.mod -d .\sp-cflp.dat --cuts

################################################
# Capacitated Facility Location Problem - CFLP 
################################################

set I:= 1   2   3   4;  # The set of all origin.
set J:= 1   2   3;      # The set of all (possible) destination points.
set W:= 1   2;          # Finite set of scenarios w in Omega

param PI:=
1   0.70
2   0.30
;

# Setup cost for facility j in J       
param F:=
1   150
2   100
3   100
; 

# Unit cost of installing a facility in j in J
param G:=
1   15
2   10
3   10
; 

# Capacity of facility j in J
param K:=
1   350
2   200
3   300
; 

# Penalty cost for Non-Satisfied Demand from oring i in I
param PC:=
1   500
2   100
3   700
4   800
; 

# # Demand at oring i in I and scenario w in W
# param D: 1  2:=
#     1   500  600
#     2   100  110
#     3   150  120
#     4   200  130
# ; 

# Revenue from patient i in I and scenario w in W
param R: 1  2:=
    1   42  41
    2   40  39
    3   38  37
    4   36  35
; 


# Assessment cost for patient i at facility j in scen w
param C 
    [*,*,1]: 1  2   3:=
    1   1   5   10
    2   2   6   11
    3   3   7   12
    4   4   8   13

    [*,*,2]: 1  2   3:=
    1   2   6   11
    2   3   7   12
    3   2   6   11
    4   3   7   12
    ;


end;
###############################################
